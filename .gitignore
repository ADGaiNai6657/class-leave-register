# ---------------------------------------------------------------- macOS 系统文件
.DS_Store
._*
.Spotlight-V100
.Trashes

# ---------------------------------------------------------------- 依赖与缓存
# 本项目零第三方依赖，这里只是防止以后误提交
node_modules/
npm-debug.log*
.npm/

# ---------------------------------------------------------------- 测试运行产物
test/.tmp/
test/.e2e/
test/.e2e-desktop/
test/.chrome-*/
test/*.log

# 端到端测试自动生成的界面截图：画面里含真实学生姓名，刻意不纳入版本库。
# 需要一并管理时，删掉下面这行即可（截图由 `npm run test:e2e` 自动生成）。
test/screenshots/

# ---------------------------------------------------------------- 真实个人信息
# 花名册是真实班级个人信息，刻意不纳入版本库（花名册文件位于上一级工作文件夹）。
*.xls
*.xlsx

# 导出的登记结果默认写在项目根目录，里面是真实学生请假信息，同样不纳入版本库。
/请假登记-*.csv

# 本地配置：里面通常写着真实班级名（导出标题），刻意不纳入版本库。
# 格式见 local-config.example.json。
/local-config.json

# ---------------------------------------------------------------- 编辑器 / IDE
.idea/
.vscode/
*.swp
